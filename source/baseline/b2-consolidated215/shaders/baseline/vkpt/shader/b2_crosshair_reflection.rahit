#version 460
#extension GL_GOOGLE_include_directive : enable

#include "path_tracer.h"
#include "utils.glsl"

#define GLOBAL_TEXTURES_DESC_SET_IDX 2
#include "global_textures.h"

#define VERTEX_BUFFER_DESC_SET_IDX 3
#define VERTEX_READONLY 1
#include "vertex_buffer.h"

#include "path_tracer_transparency.glsl"
#include "path_tracer_hit_shaders.h"

layout (location = RT_PAYLOAD_EFFECTS) rayPayloadInEXT RayPayloadEffects ray_payload;
hitAttributeEXT HitAttributeBeam beam_hit_attrib;

// B2 crosshair only. Teleport guides carry the second negative-zero tag.
// Ordinary beams, including ordinary negative alpha, retain their behaviour.
bool b2_reflection_crosshair(int primitiveID)
{
    const uvec4 tags = texelFetch(beam_info_buffer, primitiveID * 3 + 1);
    return texelFetch(beam_color_buffer, primitiveID).a < 0.0 &&
        (tags.y & 0xffff0000u) == 0x80000000u &&
        (tags.w & 0xffff0000u) != 0x80000000u;
}
void main()
{
    if (b2_reflection_crosshair(gl_PrimitiveID)) { ignoreIntersectionEXT; return; }
	const vec2 beam_fade_and_thickness = unpackHalf2x16(beam_hit_attrib.fade_and_thickness);

	vec4 transparency = pt_logic_beam(gl_PrimitiveID, beam_fade_and_thickness, gl_HitTEXT, ray_payload.rayTmax);
	
	if (transparency.a > 0)
	{
		update_payload_transparency(ray_payload, transparency, gl_HitTEXT);
	}

	ignoreIntersectionEXT;
}
