ivec2 checker_to_flat(ivec2 pos, int width)
{
	uint half_width = width / 2;
    bool is_even_checkerboard = pos.x < half_width;

	return ivec2(
		is_even_checkerboard 
			? (pos.x * 2) + (pos.y & 1)
			: ((pos.x - half_width) * 2) + ((pos.y & 1) ^ 1),
		pos.y);
}

ivec2 flat_to_checker(ivec2 pos, int width)
{
	uint half_width = width / 2;
    bool is_even_checkerboard = (pos.x & 1) == (pos.y & 1);

    return ivec2(
    	(pos.x / 2) + (is_even_checkerboard ? 0 : half_width),
    	pos.y);
}

SH b2_lf_stage_sample(int mode, ivec2 pos)
{
    if(mode == 1)
        return load_SH(TEX_PT_COLOR_LF_SH, TEX_PT_COLOR_LF_COCG, pos);
    if(mode == 2)
        return load_SH(TEX_ASVGF_HIST_COLOR_LF_SH_A, TEX_ASVGF_HIST_COLOR_LF_COCG_A, pos);
    return interpolate_lf(TEX_ASVGF_ATROUS_PING_LF_SH, TEX_ASVGF_ATROUS_PING_LF_COCG, pos);
}

void b2_lf_history_input(ivec2 ipos, out SH incoming, out float current_weight, out int status, out int reason)
{
    incoming = init_SH();
    current_weight = 1.0;
    status = 1;
    // Reason 1 is global invalidation. Inside the valid-history branch,
    // positive bilinear taps contribute bounds/surface/diffuse failure bits.
    // Bits describe the failed footprint collectively, never one unique tap.
    reason = 1;
    int rejection_mask = 0;
    vec4 motion;
	motion = texelFetch(TEX_PT_MOTION, ipos, 0);

	// Find out if this pixel belongs to a checkerboard-split-path surface
    float checkerboard_value = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0).w;
    if(isnan(checkerboard_value) || isinf(checkerboard_value) ||
       abs(checkerboard_value) > 2147483520.0)
    {
        status = 3;
        return;
    }
    int checkerboard_flags = int(checkerboard_value);
    bool is_checkerboarded_surface = bitCount(checkerboard_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1;

    // If it's a regular (non-split) surface and we're running on a single GPU,
    // we can access both checkerboard fields to get higher sampling quality
    bool sample_across_fields = !is_checkerboarded_surface && (global_ubo.current_gpu_slice_width == global_ubo.width);

    vec2 pos_prev;
    if (sample_across_fields)
    {
    	// Reprojection in flat-screen coordinates
		pos_prev = ((vec2(checker_to_flat(ipos, global_ubo.width)) + vec2(0.5)) * vec2(global_ubo.inv_width, global_ubo.inv_height) + motion.xy) * vec2(global_ubo.prev_width, global_ubo.prev_height);
	}
	else   
	{
		// Reprojection in checkerboarded coordinates
		pos_prev = ((vec2(ipos) + vec2(0.5)) * vec2(global_ubo.inv_width * 2, global_ubo.inv_height) + motion.xy) * vec2(global_ubo.prev_width / 2, global_ubo.prev_height);
	}


	// Load the parameters of the target pixel
	float depth_curr;
	vec3 normal_curr;
	depth_curr = texelFetch(TEX_PT_VIEW_DEPTH_A, ipos, 0).x;
	// Match temporal preload: decode, round through packed half, then unpack.
	normal_curr = unpackHalf4x16(packHalf4x16(vec4(
		decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x), 0.0))).xyz;


	vec3 geo_normal_curr = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);

	// Invalid coordinates cannot be converted to integer texture addresses.
	if(any(isnan(motion)) || any(isinf(motion)) ||
	   any(isnan(pos_prev)) || any(isinf(pos_prev)) || isnan(depth_curr) ||
	   isinf(depth_curr) || any(isnan(normal_curr)) || any(isinf(normal_curr)) ||
	   any(isnan(geo_normal_curr)) || any(isinf(geo_normal_curr)))
	{
		status = 3;
		return;
	}
	// Try to get the history sample for all channels, including HF moments
	bool temporal_sample_valid_diff = false;
	SH temporal_color_lf = init_SH();
	vec4 temporal_moments_histlen_hf = vec4(0);
#ifdef REFERENCE_VR_HISTORY
	if (global_ubo.temporal_history_valid != 0)
#endif
	{
		reason = 2; // No eligible in-bounds support unless the loop finds it.
		float temporal_sum_w_diff = 0.0;

		if(global_ubo.prev_width <= 0 || global_ubo.prev_height <= 0 ||
		   (global_ubo.prev_width & 1) != 0)
		{
			status = 3;
			return;
		}
		// A wholly outside finite footprint has no history. Bound the integer
		// conversion as well, including malformed extreme finite coordinates.
		if(any(lessThan(pos_prev, vec2(-1.0))) ||
		   any(greaterThan(pos_prev, vec2(global_ubo.prev_width, global_ubo.prev_height) + vec2(1.0))) ||
		   any(greaterThan(pos_prev, vec2(2147483520.0))))
			return;
		vec2 pos_ld = floor(pos_prev - vec2(0.5));
		vec2 subpix = fract(pos_prev - vec2(0.5) - pos_ld);

		int field_left = 0;
		int field_right = sample_across_fields ? global_ubo.prev_width : (global_ubo.prev_width / 2);
		if (!sample_across_fields && ipos.x >= global_ubo.width / 2)
		{
			field_left = field_right;
			field_right = global_ubo.prev_width;
		}

		// Bilinear/bilateral filter
		const ivec2 off[4] = { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } };
		float w[4] = {
			(1.0 - subpix.x) * (1.0 - subpix.y),
			(subpix.x      ) * (1.0 - subpix.y),
			(1.0 - subpix.x) * (subpix.y      ),
			(subpix.x      ) * (subpix.y      )
		};
		for(int i = 0; i < 4; i++) {
			ivec2 p = ivec2(pos_ld) + off[i];

			if(p.x < field_left || p.x >= field_right || p.y < 0 || p.y >= global_ubo.prev_height)
			{
				if(w[i] > 0.0) rejection_mask |= 1;
				continue;
			}

			if (sample_across_fields)
			{
				// If we're sampling both checker fields, `p` is calculated in flat coordinates,
				// so translate it back into checkerboarded coordinates to load the G-buffer data
				p = flat_to_checker(p, global_ubo.prev_width);
			}

			float depth_prev = texelFetch(TEX_PT_VIEW_DEPTH_B, p, 0).x;
			vec3  normal_prev = decode_normal(texelFetch(TEX_PT_NORMAL_B, p, 0).x);
			vec3  geo_normal_prev = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_B, p, 0).x);
			// Diagnostic validity is separate from the production admission tests.
			if(isnan(depth_prev) || isinf(depth_prev) ||
			   any(isnan(normal_prev)) || any(isinf(normal_prev)) ||
			   any(isnan(geo_normal_prev)) || any(isinf(geo_normal_prev)))
			{
				status = 3;
				return;
			}

			float dist_depth = abs(depth_curr - depth_prev + motion.z) / abs(depth_curr);
			float dot_normals = dot(normal_curr, normal_prev);
			float dot_geo_normals = dot(geo_normal_curr, geo_normal_prev);
			
			if(depth_curr < 0)
			{
				// Reduce the filter sensitivity to depth for secondary surfaces,
				// because reflection/refraction motion vectors are often inaccurate.
				dist_depth *= 0.25;
			}

			// Non-finite derived comparisons are malformed, not a surface reason.
			if(isnan(dist_depth) || isinf(dist_depth) ||
			   isnan(dot_normals) || isinf(dot_normals) ||
			   isnan(dot_geo_normals) || isinf(dot_geo_normals))
			{
				status = 3;
				return;
			}
			if(w[i] > 0.0)
				rejection_mask |= (dist_depth < 0.1 && dot_geo_normals > 0.5) ? 4 : 2;

			if(dist_depth < 0.1 && dot_geo_normals > 0.5)
			{
				float w_diff = w[i] * max(dot_normals, 0);

				SH hist_color_lf = load_SH(TEX_ASVGF_HIST_COLOR_LF_SH_B, TEX_ASVGF_HIST_COLOR_LF_COCG_B, p);
				if(!b2_lf_finite_signal(hist_color_lf))
				{
					status = 3;
					return;
				}
				accumulate_SH(temporal_color_lf, hist_color_lf, w_diff);

				vec4 previous_moments = texelFetch(TEX_ASVGF_HIST_MOMENTS_HF_B, p, 0);
				if(isnan(previous_moments.a) || isinf(previous_moments.a))
				{
					status = 3;
					return;
				}
				temporal_moments_histlen_hf += previous_moments * w_diff;
				temporal_sum_w_diff           += w_diff;
			}
		}

		// Interpret the mask only when the total diffuse weight is unusable.
		// A surface-passing tap then belongs to normal/tiny-weight rejection,
		// even if its own positive contribution was too small in aggregate.
		if(rejection_mask == 1) reason = 2;
		else if(rejection_mask == 2) reason = 3;
		else if(rejection_mask == 4) reason = 4;
		else if(rejection_mask != 0) reason = 5;

		// We found some relevant surfaces - good
		if(temporal_sum_w_diff > 1e-6)
		{
			float inv_w_diff = 1.0 / temporal_sum_w_diff;
			temporal_color_lf.shY         *= inv_w_diff;
			temporal_color_lf.CoCg        *= inv_w_diff;
			temporal_moments_histlen_hf   *= inv_w_diff;
			temporal_sample_valid_diff    = true;
		}

	}


    incoming = temporal_color_lf;
    if(!temporal_sample_valid_diff) return;
	float grad_lf = texelFetch(TEX_ASVGF_GRAD_LF_PONG, ipos / GRAD_DWN, 0).r;
	// Flag invalid inputs before clamping or the coverage override can hide them.
	if(isnan(grad_lf) || isinf(grad_lf) ||
	   isnan(temporal_moments_histlen_hf.a) || isinf(temporal_moments_histlen_hf.a))
	{
		status = 3;
		return;
	}
	grad_lf = clamp(grad_lf, 0, 1);
	float antilag_alpha_lf = clamp(mix(1.0, global_ubo.flt_antilag_lf * grad_lf, global_ubo.flt_temporal_lf), 0, 1);
	float hist_len_lf = min(temporal_moments_histlen_hf.a * pow(1.0 - antilag_alpha_lf, 10) + 1.0, 256.0);
	float alpha_color_lf = max(global_ubo.flt_min_alpha_color_lf, 1.0 / hist_len_lf);
	alpha_color_lf = mix(alpha_color_lf, 1.0, antilag_alpha_lf);
    current_weight = alpha_color_lf;
    status = 0;
    reason = 0;
    // Current production has no incomplete-coverage reset override.
    if(!b2_lf_finite_signal(incoming) || isnan(current_weight) ||
       isinf(current_weight) || current_weight < 0.0 || current_weight > 1.0)
        status = 3;
}

vec3 b2_lf_reason_colour(int status, int reason)
{
    if(status == 3) return vec3(1, 0, 1);
    if(status == 0) return vec3(0, 0.7, 0);
    if(reason == 1) return vec3(0.1, 0.25, 1);
    if(reason == 2) return vec3(0, 1, 1);
