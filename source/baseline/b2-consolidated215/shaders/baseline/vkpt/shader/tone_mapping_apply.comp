vec3 b2_cycle_label(ivec2 pos, int mode, bool supported, vec3 colour)
{
    ivec2 q = pos - ivec2(12, 12);
    int label_mode = mode == 8 ? 0 : mode;
    int rows = label_mode == 6 ? 8 : 5;
    if(q.x < 0 || q.y < 0 || q.x >= 432 || q.y >= rows * 16) return colour;
    int row = q.y / 16;
    int index = q.x / 12;
    int character = b2_cycle_text[(label_mode * 8 + row) * 36 + index];
    if(!supported && row == 1) character = b2_cycle_invalid[index];
    ivec2 dotpos = ivec2((q.x % 12) / 2, (q.y % 16) / 2);
    bool ink = dotpos.x < 5 && dotpos.y < 5 &&
        ((b2_lf_glyph(character) >> uint(dotpos.y * 5 + dotpos.x)) & 1u) != 0u;
    return ink ? vec3(1) : vec3(0.01);
}

bool b2_lf_stage_readout(ivec2 output_pos, out vec3 colour)
{
    int mode = b2_lf_stage_mode(global_ubo.flt_show_gradients);
    if(mode < 1 || mode > 6) return false;
    // Retain TAA2/jitter. This is the nearest current render sample, not TAA.
    bool supported = spec_tone_mapping_hdr == 0 && global_ubo.width > 0 &&
        (global_ubo.width & 1) == 0 && global_ubo.height > 0 &&
        global_ubo.taa_output_width > 0 && global_ubo.taa_output_height > 0 &&
        global_ubo.current_gpu_slice_width == global_ubo.width &&
        global_ubo.flt_enable != 0 && global_ubo.pt_num_bounce_rays >= 0.5 &&
        global_ubo.temporal_blend_factor <= 0 &&
        !any(isnan(global_ubo.sub_pixel_jitter)) && !any(isinf(global_ubo.sub_pixel_jitter)) &&
        all(lessThanEqual(abs(global_ubo.sub_pixel_jitter), vec2(1)));
    colour = vec3(1, 0, 1);
    if(supported)
    {
        ivec2 p = b2_lf_packed_position(output_pos);
        float encoded_flags = texelFetch(TEX_PT_VIEW_DIRECTION, p, 0).a;
        bool valid_flags = !isnan(encoded_flags) && !isinf(encoded_flags) &&
            encoded_flags >= 0.0 && encoded_flags <= 15.0;
        int flags = valid_flags ? int(encoded_flags) : 0;
        if(valid_flags && (flags & CHECKERBOARD_FLAG_FIELD_MASK) == CHECKERBOARD_FLAG_PRIMARY)
        {
            vec3 normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, p, 0).x);
            if(mode >= 4)
            {
                SH incoming; float current_weight; int status; int reason;
                b2_lf_history_input(p, incoming, current_weight, status, reason);
                if(mode == 6) colour = b2_lf_reason_colour(status, reason);
                else if(mode == 5) colour = b2_lf_weight_colour(current_weight, status);
                else if(status == 3) colour = vec3(1, 0, 1);
                else if(status == 1) colour = vec3(0, 1, 1);
                else colour = b2_lf_display_colour(incoming, normal);
            }
            else colour = b2_lf_display_colour(b2_lf_stage_sample(mode, p), normal);
        }
    }
    colour = b2_cycle_label(output_pos, mode, supported, colour);
    return true;
}



