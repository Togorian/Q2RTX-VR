vec3 b2_lf_weight_colour(float current_weight, int status)
{
    if(status == 3) return vec3(1, 0, 1);
    if(status == 1) return vec3(0, 1, 1);
    if(status != 0) return vec3(1, 0, 1);
    return mix(vec3(0, 0.1, 1), vec3(1, 1, 0), current_weight);
}

int b2_lf_stage_mode(float selector)
{
    if(selector == -1.0) return 1;
    if(selector == -2.0) return 2;
    if(selector == -3.0) return 3;
    if(selector == -4.0) return 4;
    if(selector == -5.0) return 5;
    if(selector == -6.0) return 6;
    if(selector == -7.0) return 7;
    if(selector == -8.0) return 8; // Private labelled Normal; product0 unchanged.
    return 0;
}

