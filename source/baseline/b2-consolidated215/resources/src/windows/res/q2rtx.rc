// Modified 12 November 2026: product branding and VERSION-derived prerelease status.

/* Modified by Togorian with AI assistance, 12 November 2026, for Q2RTX VR
 * (OpenXR VR support and source preparation). See PROVENANCE.md. */
// Modified 11 November 2026: rc.2 metadata; upstream copyright retained.
/* Modified 11 November 2026: added provenance notice for the Q2RTX VR
 * source selection. Earlier adaptations retain their original notices;
 * see docs/MODIFICATIONS.md and docs/PROVENANCE.md. */
#if HAVE_CONFIG_H
#include "../../../inc/shared/config.h"
#endif

#include <windows.h>

#pragma code_page(65001)

#if USE_DEBUG
#define VER_FILEFLAGS   VS_FF_DEBUG
#else
#define VER_FILEFLAGS   0x0L
#endif

#define VER_FILEDESCRIPTION_STR     "Q2RTX VR client " Q2RTX_PRODUCT_VERSION
#define VER_ORIGINALFILENAME_STR    "q2rtx.exe"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     Q2RTX_PRODUCT_VERSION_RESOURCE
    PRODUCTVERSION  Q2RTX_PRODUCT_VERSION_RESOURCE
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       (VER_FILEFLAGS | Q2RTX_PRODUCT_PRERELEASE)
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", VER_FILEDESCRIPTION_STR
            VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
            VALUE "FileVersion", Q2RTX_PRODUCT_VERSION
            VALUE "InternalName", "q2rtx"
            VALUE "LegalCopyright", "Copyright (C) 2019-2025, NVIDIA CORPORATION. All rights reserved. Copyright (C) 2026 Togorian"
            VALUE "CompanyName", "Togorian"
            VALUE "ProductName", "Q2RTX VR"
            VALUE "ProductVersion", Q2RTX_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END

LANGUAGE LANG_NEUTRAL, SUBLANG_DEFAULT

100 ICON "q2rtx.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "q2rtx.exe.manifest"
