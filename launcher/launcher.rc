#include <windows.h>
#include "q2rtx-product-version.h"
1 VERSIONINFO
FILEVERSION Q2RTX_PRODUCT_VERSION_RESOURCE
PRODUCTVERSION Q2RTX_PRODUCT_VERSION_RESOURCE
FILEFLAGSMASK 0x3fL
FILEFLAGS Q2RTX_PRODUCT_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Q2RTX VR launcher\0"
      VALUE "FileVersion", Q2RTX_PRODUCT_VERSION "\0"
      VALUE "CompanyName", "Togorian"
            VALUE "ProductName", "Q2RTX VR\0"
      VALUE "ProductVersion", Q2RTX_PRODUCT_VERSION "\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Togorian"
      VALUE "OriginalFilename", "Q2RTX VR.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

100 ICON "q2rtx.ico"
