// The generator inserts exact selected Pmove and guard source. Deterministic
// world callbacks exercise the failure route without a game or a headset.
#include "shared/shared.h"
#include "common/pmove.h"
#include <assert.h>

typedef struct { int unused; } gitem_t;
typedef struct edict_s {
    int deadflag, waterlevel, watertype;
    struct { int modelindex; } s;
} edict_t;
#define OBS_CONTACT_LIMIT 4
/* OBSERVER_STATE */
static struct { bool enabled; unsigned relocations; } combat;
static struct { int framenum; } level;
static bool b2tp_moved;
static unsigned refusal_mask;
static const char *refusal_phase;
static cvar_t quiet;
static int contents_calls, initial_attempt, accept_initial;
static bool final_clear;

static void diagnostic(const char *format, ...)
{
    if (!strncmp(format, "B2_WALK_PM_REASON ", 18)) {
        va_list args;
        va_start(args, format);
        (void)va_arg(args, int);
        refusal_mask = va_arg(args, unsigned);
        va_end(args);
    }
}
static cvar_t *test_cvar(const char *name, const char *value, int flags) { return &quiet; }
static int world_contents(const vec3_t point) { contents_calls++; return CONTENTS_WATER; }
static struct {
    void (*dprintf)(const char *, ...);
    cvar_t *(*cvar)(const char *, const char *, int);
    int (*pointcontents)(const vec3_t);
} gi = { diagnostic, test_cvar, world_contents };
static bool G_ObserverTracing(edict_t *ent) { return true; }
static void G_ObserverTrace(const char *phase, edict_t *ent) { }
static bool observer_sample(const char *phase, edict_t *ent, bool force) { return false; }
static void observer_print_pm(const char *which, const pmove_state_t *state) { }
static int observer_number(edict_t *ent) { return ent ? 1 : -1; }
static const char *observer_class(edict_t *ent) { return "fixture"; }
static void observer_walk_fault(const char *phase, edict_t *ent)
{
    obs_trace.walk_faulted = true;
    refusal_phase = phase;
}

/* PMOVE */
/* SNAP_HELPER */
/* VALIDATOR */
/* CALLBACKS */

static trace_t q_gameabi world_trace(const vec3_t start, const vec3_t mins,
                                    const vec3_t maxs, const vec3_t end)
{
    trace_t trace = {0};
    trace.fraction = 1.f;
    VectorCopy(end, trace.endpos);
    if (!memcmp(start, end, sizeof(vec3_t))) {
        // Before the first contents call these are actual initial-snap tests.
        // Later stationary probes comprise step-up and final quantisation.
        bool blocked = contents_calls ? !(final_clear && contents_calls >= 6) :
            initial_attempt++ != accept_initial;
        if (blocked) {
            trace.allsolid = trace.startsolid = true;
            trace.fraction = 0.f;
            trace.contents = CONTENTS_MONSTER;
        }
    }
    G_ObserverCollision(start, end, &trace);
    return trace;
}

static edict_t player;
static pmove_t movement;

static void capture(int initial, bool clear)
{
    pmoveParams_t parameters;
    memset(&obs_trace, 0, sizeof obs_trace);
    memset(&player, 0, sizeof player);
    memset(&movement, 0, sizeof movement);
    combat.enabled = true;
    obs_trace.walk_guard = obs_trace.vertical = obs_trace.command_active = true;
    refusal_mask = 0;
    refusal_phase = NULL;
    contents_calls = initial_attempt = 0;
    accept_initial = initial;
    final_clear = clear;
    movement.s.pm_type = PM_NORMAL;
    movement.s.origin[0] = 9319;
    movement.s.origin[1] = -8172;
    movement.s.origin[2] = 8505;
    movement.s.velocity[0] = -17;
    movement.s.velocity[1] = 21;
    movement.s.velocity[2] = -162;
    movement.s.gravity = 800;
    movement.snapinitial = initial >= 0;
    movement.cmd.msec = 37;
    movement.trace = world_trace;
    movement.pointcontents = G_ObserverPointContents;
    obs_trace.command = movement.cmd;
    PmoveInit(&parameters);
    G_ObserverPmove(&player, &movement, true);
    Pmove(&movement, &parameters);
    assert(contents_calls == 6);
    if (initial >= 0) assert(initial_attempt == min(initial + 1, 27));
    if (!clear) assert(obs_trace.pm_tail_count >= 8);
}

static void validate(bool expected_fault, unsigned expected_mask)
{
    obs_trace.walk_faulted = false;
    refusal_mask = 0;
    refusal_phase = NULL;
    G_ObserverPmove(&player, &movement, false);
    assert(obs_trace.walk_faulted == expected_fault);
    assert(refusal_mask == expected_mask);
    if (expected_fault) assert(!strcmp(refusal_phase, "unsupported_pmove_result"));
}

static void set_attempted_origin(const vec3_t attempted)
{
    // Tamper consistently with retained final samples and traces, so the
    // integration bound itself must reject the otherwise coherent evidence.
    static const byte bits[8] = {0, 4, 1, 2, 3, 5, 6, 7};
    const int height[3] = {-23, -1, 22};
    for (unsigned i = 0; i < 3; ++i)
        for (unsigned axis = 0; axis < 3; ++axis)
            obs_trace.content[3 + i].point[axis] = attempted[axis] + (axis == 2 ? height[i] : 0);
    for (unsigned i = 0; i < 8; ++i) {
        unsigned n = (obs_trace.pm_tail_count - 8 + i) % 8;
        for (unsigned axis = 0; axis < 3; ++axis) {
            int base = (int)(attempted[axis] * 8);
            int sign = base * .125f == attempted[axis] ? 0 : attempted[axis] >= 0 ? 1 : -1;
            float value = (base + ((bits[i] & (1 << axis)) ? sign : 0)) * .125f;
            obs_trace.pm_tail[n].start[axis] = obs_trace.pm_tail[n].end[axis] = value;
        }
    }
}

int main(void)
{
    // Existing no-initial-snap and successful-final-snap behaviour stays valid.
    capture(-1, false); validate(false, 0);
    capture(-1, true); validate(false, 0);
    capture(0, true); validate(false, 0);
#ifdef EXPECT_PREVIOUS_REFUSAL
    for (int initial = 0; initial <= 27; ++initial) {
        capture(initial, false);
        validate(true, BIT(3));
    }
    puts("PRE-CORRECTION: actual stock Pmove initial-snap/final-fallback refused solely by sample-origin guard (all 27 success positions and full initial failure)");
#else
    for (int initial = 0; initial <= 27; ++initial) {
        capture(initial, false);
        validate(false, 0);
    }
    puts("PASS: actual stock Pmove unchanged/shifted/all-failed initial snap followed by eight-failed final snap");

    capture(0, false); obs_trace.pm_tail[(obs_trace.pm_tail_count - 1) % 8].trace.allsolid = false; validate(true, BIT(3));
    capture(0, false); obs_trace.pm_tail[(obs_trace.pm_tail_count - 1) % 8].start[0] += .125f; validate(true, BIT(3));
    capture(0, false); obs_trace.pm_tail_count = 7; validate(true, BIT(3));
    capture(0, false); movement.s.origin[0]++; validate(true, BIT(3));
    capture(0, false); obs_trace.content[0].point[0] += .125f; validate(true, BIT(3));
    capture(0, false); obs_trace.content[0].point[0] += .01f; validate(true, BIT(3));
    capture(0, false); obs_trace.content[0].point[0] = NAN; validate(true, BIT(3));
    capture(0, false); movement.s.origin[0] += 2; obs_trace.content[0].point[0] += .25f; validate(true, BIT(3));
    capture(0, false); obs_trace.content[4].contents = 0; validate(true, BIT(3));
    capture(0, false); obs_trace.content[4].point[1] += 1.f; validate(true, BIT(3));
    capture(0, false); obs_trace.content[3].point[0] = NAN; validate(true, BIT(3));
    capture(0, false); obs_trace.content_count = 9; validate(true, BIT(3));
    capture(0, false); obs_trace.content_count = 0; validate(true, BIT(3));
    capture(0, false); movement.watertype = CONTENTS_SLIME; validate(true, BIT(3));
    capture(0, false); {
        vec3_t attempted = {movement.s.origin[0] * .125f + 100.f,
            movement.s.origin[1] * .125f, movement.s.origin[2] * .125f};
        set_attempted_origin(attempted); validate(true, BIT(3));
    }
    capture(0, false); {
        vec3_t attempted = {movement.s.origin[0] * .125f,
            movement.s.origin[1] * .125f, movement.s.origin[2] * .125f - 100.f};
        set_attempted_origin(attempted); validate(true, BIT(3));
    }
    capture(0, false); movement.s.velocity[0] = 30000; validate(true, BIT(12));
    capture(0, false); movement.cmd.buttons ^= BUTTON_ATTACK; validate(true, BIT(4));
    capture(0, false); obs_trace.command_active = false; validate(true, BIT(0));
    capture(0, false); movement.s.gravity++; validate(true, BIT(8));
    capture(0, false); movement.s.delta_angles[1]++; validate(true, BIT(9));
    puts("PASS: malformed trace, sample, quantisation, restoration, callback-count, attempted-travel, speed and ownership evidence still refused");
#endif
    return 0;
}
